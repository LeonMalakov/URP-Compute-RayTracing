// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

#define TRACE_REFLECTIONS

#include "../ShaderLibrary/RayTracing.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/GBufferInput.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<half3> Result;

float4x4 _ScreenToWorld[2];
//float3 _WorldSpaceCameraPos;

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    GBufferData gBuffer = UnpackGBuffers(id.xy);
    half3 normalWs = gBuffer.normalWS;
    float depth = gBuffer.depth;

    float4 posWS = mul(_ScreenToWorld[SLICE_ARRAY_INDEX], float4(id.xy, depth, 1.0));
    posWS.xyz *= rcp(posWS.w);


    Light mainLight = GetMainLight();
    //mainLight.distanceAttenuation = 1.0;
    //half3 lightPos = half3(4.5, 3, 10);
    
    //half3 rayDirection = normalize(lightPos - posWS.xyz);

    float3 viewDir = normalize(posWS.xyz - _WorldSpaceCameraPos);
    //half3 rayDirection = normalize(mainLight.direction);
    half3 rayDirection = normalize(reflect(viewDir, normalWs));
    half3 rayOrigin = posWS.xyz + rayDirection * 0.08;
    
    TraceReflectionsResult hit = Trace(rayOrigin, rayDirection);

    //Result[id.xy] = hit ? half3(depth, 0.0, 0.0) : half3(depth, 0.0, 1.0);

    if(!hit.hit)
    {
        Result[id.xy] = half3(1.0, 1.0, 1.0);
    } else
    {
        MaterialInfo material = GetMaterialInfo(hit.materialIndex);
        half4 baseMap = SampleBaseMap(material.baseMapIndex, hit.mainUV);
        Result[id.xy] = baseMap.rgb;
    }
}
